# RUN: llc -mtriple=amdgcn -mcpu=gfx1201 -verify-machineinstrs -run-pass=gcn-create-vopd %s -o - | FileCheck %s --check-prefix=OFF
# RUN: llc -mtriple=amdgcn -mcpu=gfx1201 -verify-machineinstrs -run-pass=gcn-create-vopd -amdgpu-dlss5-vopd-lookahead=4 %s -o - | FileCheck %s --check-prefix=ON
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -verify-machineinstrs -run-pass=gcn-create-vopd -amdgpu-dlss5-vopd-lookahead=4 %s -o - | FileCheck %s --check-prefix=OFF

---
name: independent_salu
tracksRegLiveness: true
body: |
  bb.0:
    ; OFF-LABEL: name: independent_salu
    ; OFF: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; OFF-NEXT: $sgpr0 = S_MOV_B32 7
    ; OFF-NEXT: $vgpr1 = V_MOV_B32_e32 2, implicit $exec
    ; ON-LABEL: name: independent_salu
    ; ON: $vgpr0, $vgpr1 = V_DUAL_MOV_B32_e32_X_MOV_B32_e32_gfx12 1, 2,
    ; ON-NEXT: $sgpr0 = S_MOV_B32 7
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    $sgpr0 = S_MOV_B32 7
    $vgpr1 = V_MOV_B32_e32 2, implicit $exec
...
---
name: raw_sgpr
tracksRegLiveness: true
body: |
  bb.0:
    ; ON-LABEL: name: raw_sgpr
    ; ON: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; ON-NEXT: $sgpr0 = S_MOV_B32 7
    ; ON-NEXT: $vgpr1 = V_MOV_B32_e32 killed $sgpr0, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    $sgpr0 = S_MOV_B32 7
    $vgpr1 = V_MOV_B32_e32 killed $sgpr0, implicit $exec
...
---
name: war_vgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr1
    ; ON-LABEL: name: war_vgpr
    ; ON: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; ON-NEXT: $sgpr0 = V_READFIRSTLANE_B32 $vgpr1, implicit $exec
    ; ON-NEXT: $vgpr1 = V_MOV_B32_e32 2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    $sgpr0 = V_READFIRSTLANE_B32 $vgpr1, implicit $exec
    $vgpr1 = V_MOV_B32_e32 2, implicit $exec
...
---
name: waw_vgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2
    ; ON-LABEL: name: waw_vgpr
    ; ON: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; ON-NEXT: $vgpr1 = V_NOT_B32_e32 $vgpr2, implicit $exec
    ; ON-NEXT: $vgpr1 = V_MOV_B32_e32 2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    $vgpr1 = V_NOT_B32_e32 $vgpr2, implicit $exec
    $vgpr1 = V_MOV_B32_e32 2, implicit $exec
...
---
name: exec_alias
tracksRegLiveness: true
body: |
  bb.0:
    ; ON-LABEL: name: exec_alias
    ; ON: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; ON-NEXT: $exec_lo = S_MOV_B32 0
    ; ON-NEXT: $vgpr1 = V_MOV_B32_e32 2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    $exec_lo = S_MOV_B32 0
    $vgpr1 = V_MOV_B32_e32 2, implicit $exec
...
---
name: synchronization_boundary
tracksRegLiveness: true
body: |
  bb.0:
    ; ON-LABEL: name: synchronization_boundary
    ; ON: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; ON-NEXT: S_NOP 0
    ; ON-NEXT: $vgpr1 = V_MOV_B32_e32 2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    S_NOP 0
    $vgpr1 = V_MOV_B32_e32 2, implicit $exec
...
---
name: clear_moved_kill
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2
    ; ON-LABEL: name: clear_moved_kill
    ; ON: $vgpr0, $vgpr1 = V_DUAL_MOV_B32_e32_X_MOV_B32_e32_gfx12 1, $vgpr2,
    ; ON-NEXT: $sgpr0 = V_READFIRSTLANE_B32 $vgpr2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    $sgpr0 = V_READFIRSTLANE_B32 $vgpr2, implicit $exec
    $vgpr1 = V_MOV_B32_e32 killed $vgpr2, implicit $exec
...
