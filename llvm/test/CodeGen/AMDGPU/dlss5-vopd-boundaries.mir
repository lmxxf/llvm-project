# RUN: llc -mtriple=amdgcn -mcpu=gfx1201 -verify-machineinstrs -run-pass=gcn-create-vopd -amdgpu-dlss5-vopd-lookahead=4 %s -o - | FileCheck %s --check-prefix=FOUR
# RUN: llc -mtriple=amdgcn -mcpu=gfx1201 -verify-machineinstrs -run-pass=gcn-create-vopd -amdgpu-dlss5-vopd-lookahead=2 %s -o - | FileCheck %s --check-prefix=TWO

---
name: mode_boundary
tracksRegLiveness: true
body: |
  bb.0:
    ; FOUR-LABEL: name: mode_boundary
    ; FOUR: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; FOUR-NEXT: S_SETREG_IMM32_B32 0, 1, implicit-def $mode, implicit $mode
    ; FOUR-NEXT: $vgpr1 = V_MOV_B32_e32 2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    S_SETREG_IMM32_B32 0, 1, implicit-def $mode, implicit $mode
    $vgpr1 = V_MOV_B32_e32 2, implicit $exec
...
---
name: memory_boundary
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr4_sgpr5
    ; FOUR-LABEL: name: memory_boundary
    ; FOUR: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; FOUR-NEXT: $sgpr0 = S_LOAD_DWORD_IMM $sgpr4_sgpr5, 0, 0
    ; FOUR-NEXT: $vgpr1 = V_MOV_B32_e32 2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    $sgpr0 = S_LOAD_DWORD_IMM $sgpr4_sgpr5, 0, 0 :: (load (s32), addrspace 4)
    $vgpr1 = V_MOV_B32_e32 2, implicit $exec
...
---
name: bounded_window
tracksRegLiveness: true
body: |
  bb.0:
    ; FOUR-LABEL: name: bounded_window
    ; FOUR: $vgpr0, $vgpr1 = V_DUAL_MOV_B32_e32_X_MOV_B32_e32_gfx12 1, 2,
    ; FOUR-NEXT: $sgpr0 = S_MOV_B32 7
    ; FOUR-NEXT: $sgpr1 = S_MOV_B32 8
    ; TWO-LABEL: name: bounded_window
    ; TWO: $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    ; TWO-NEXT: $sgpr0 = S_MOV_B32 7
    ; TWO-NEXT: $sgpr1 = S_MOV_B32 8
    ; TWO-NEXT: $vgpr1 = V_MOV_B32_e32 2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 1, implicit $exec
    $sgpr0 = S_MOV_B32 7
    $sgpr1 = S_MOV_B32 8
    $vgpr1 = V_MOV_B32_e32 2, implicit $exec
...
